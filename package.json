{
  "name": "topgap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "format": "prettier --write src messages tests scripts next.config.ts eslint.config.mjs postcss.config.mjs tsconfig.json package.json .prettierrc.json README.md MATCHUP-POCS.md",
    "format:check": "prettier --check src messages tests scripts next.config.ts eslint.config.mjs postcss.config.mjs tsconfig.json package.json .prettierrc.json README.md MATCHUP-POCS.md"
  },
  "dependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "next-intl": "^4.14.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
